# Copy this file to .env before running Docker Compose.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Optional. Without this, the application uses a deliberately small, safe local
# resolver for common requests such as "find email addresses".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Tune these to the worker resources available to the deployment.
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=16
SPARK_ROWS_PER_PARTITION=250000
RESULT_PREVIEW_LIMIT=500

